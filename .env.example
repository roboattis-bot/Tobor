# Optional. The application uses these defaults when omitted.
PORT=3001
HOST=127.0.0.1
DATABASE_PATH=./data/tobor.sqlite
# Set to production behind an HTTPS reverse proxy for Secure cookies.
NODE_ENV=development
# Defaults to true in production. Set false only for an intentional HTTP LAN deployment.
# COOKIE_SECURE=false
SESSION_TTL_HOURS=12
UPLOAD_DIR=./data/uploads
# First database creation only. Set false before first start for empty records.
SEED_DEMO=true
# Optional exact public origin, for example https://workshop.example.com
# APP_ORIGIN=https://workshop.example.com
